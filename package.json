{
  "name": "haunted-hollow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "assets:collect": "tsx scripts/collect/index.ts",
    "assets:collect:all": "tsx scripts/collect/index.ts --all",
    "assets:verify": "tsx scripts/verify-assets.ts",
    "assets:credits": "tsx scripts/collect/credits-cli.ts",
    "assets:placeholders": "tsx scripts/collect/placeholders.ts",
    "test:e2e": "playwright test",
    "lit:collect": "tsx scripts/collect/lit/index.ts --all",
    "lit:verify": "tsx scripts/collect/lit/index.ts --verify"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
